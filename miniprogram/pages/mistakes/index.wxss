/* pages/mistakes/index.wxss - 错题本样式 */

/* 统计栏 */
.stats-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 24rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary-color);
  animation: countUp 0.6s ease both;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: var(--border-color);
}

/* 科目筛选栏 */
.subject-filter {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.subject-filter-inner {
  display: flex;
  gap: 16rpx;
  padding: 0 4rpx;
}

.subject-tag {
  display: inline-block;
  padding: 10rpx 28rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: #f0f0f0;
  flex-shrink: 0;
}

.subject-tag.active {
  color: #ffffff;
  background: var(--primary-color);
}

/* 日期筛选 */
.date-filter {
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.date-filter-inner {
  align-items: center;
}

.filter-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-right: 12rpx;
}

.filter-date {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.filter-clear {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-left: auto;
}

/* 错题项 */
.mistake-item {
  padding: 24rpx;
}

.mistake-header {
  margin-bottom: 16rpx;
}

.mistake-subject {
  font-size: 24rpx;
  color: #ffffff;
  background: var(--primary-color);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.mistake-time {
  font-size: 22rpx;
  color: var(--text-hint);
}

.mistake-body {
  margin-bottom: 16rpx;
}

.mistake-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.mistake-text {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.mistake-desc {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.mistake-error {
  font-size: 24rpx;
  color: var(--accent-color);
  margin-top: 8rpx;
}

.mistake-footer {
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: flex-end;
}

.action-btn {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
}

.action-btn.delete {
  color: var(--danger-color);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  animation: fadeIn 0.5s ease both;
}

.empty-text {
  font-size: 28rpx;
  color: #bbb;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
  margin-top: 8rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-hint);
}

/* 浮动添加按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.4);
  z-index: 50;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.fab-btn:active {
  transform: scale(0.9);
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.3);
}

.fab-icon {
  font-size: 56rpx;
  color: #ffffff;
  line-height: 1;
}

/* 弹窗通用 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx;
  z-index: 101;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

/* 表单项 */
.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 8rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.form-value {
  font-size: 28rpx;
  color: var(--text-primary);
}

.placeholder {
  color: var(--text-hint);
}

.form-item-textarea {
  margin-bottom: 16rpx;
}

.modal-textarea {
  width: 100%;
  height: 140rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-item-upload {
  margin-bottom: 24rpx;
}

/* 弹窗按钮 */
.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.modal-btns .btn-secondary,
.modal-btns .btn-primary {
  flex: 1;
}

/* 选择器弹窗 */
.picker-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx;
  z-index: 102;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  display: block;
}

.picker-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.picker-item {
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  font-size: 28rpx;
  color: var(--text-primary);
}

.picker-item.active {
  background: rgba(7, 193, 96, 0.1);
  color: var(--primary-color);
  font-weight: 500;
}

/* 详情弹窗 */
.detail-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 85%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx;
  z-index: 101;
  max-height: 80vh;
  overflow-y: auto;
}

.detail-header {
  margin-bottom: 20rpx;
}

.detail-subject {
  font-size: 28rpx;
  color: #ffffff;
  background: var(--primary-color);
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.detail-close {
  font-size: 48rpx;
  color: var(--text-hint);
  line-height: 1;
}

.detail-images {
  margin-bottom: 20rpx;
}

.detail-img {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.detail-desc {
  margin-bottom: 16rpx;
}

.detail-desc-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

.detail-error {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.detail-error-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.detail-error-value {
  font-size: 26rpx;
  color: var(--accent-color);
  font-weight: 500;
}

.detail-time {
  font-size: 24rpx;
  color: var(--text-hint);
}

.detail-footer {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.detail-delete {
  color: var(--danger-color);
  border-color: var(--danger-color);
}
