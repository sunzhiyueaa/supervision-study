/* pages/rewards/index.wxss - 积分奖励样式 */

/* ========== 顶部用户信息+积分卡片 ========== */
.profile-card {
  background: linear-gradient(135deg, #07c160, #4cd964);
  color: #ffffff;
  padding: 40rpx 30rpx;
  position: relative;
  overflow: hidden;
}

/* 装饰圆 */
.profile-card::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.profile-card::after {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: -60rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.profile-top {
  margin-bottom: 30rpx;
  position: relative;
  z-index: 1;
}

.avatar-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}

.profile-info {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.streak-badge {
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  align-self: flex-start;
}

.streak-icon {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.streak-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.95);
}

/* ========== 积分展示 ========== */
.points-display {
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  position: relative;
  z-index: 1;
  backdrop-filter: blur(4rpx);
}

.points-main, .points-sub {
  align-items: center;
  flex: 1;
}

.points-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 6rpx;
}

/* 积分数字滚动动画 */
.points-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.1;
  animation: countUp 0.8s ease both;
}

.points-sub-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.1;
  animation: countUp 0.8s ease both;
}

.points-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* ========== 成就徽章 ========== */
.achievement-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

.achievement-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 10rpx;
  box-sizing: border-box;
  transition: transform 0.2s ease;
}

.achievement-item:active {
  transform: scale(0.95);
}

.achievement-item.locked {
  opacity: 0.4;
  filter: grayscale(1);
}

.achievement-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  position: relative;
}

.achievement-item.unlocked .achievement-icon-wrap {
  background: linear-gradient(135deg, #FFF8E1, #FFE082);
  box-shadow: 0 4rpx 16rpx rgba(255, 193, 7, 0.3);
  animation: pulse 3s ease infinite;
}

/* 解锁光效 */
.achievement-glow {
  position: absolute;
  top: -4rpx;
  left: -4rpx;
  right: -4rpx;
  bottom: -4rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 193, 7, 0.4);
  animation: pulse 2s ease infinite;
}

.achievement-icon {
  font-size: 40rpx;
}

.achievement-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 2rpx;
}

.achievement-item.locked .achievement-name {
  color: #999;
}

.achievement-desc {
  font-size: 18rpx;
  color: #999;
}

/* ========== 积分规则 ========== */
.rule-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background 0.2s ease;
}

.rule-item:last-child {
  border-bottom: none;
}

.rule-name {
  font-size: 28rpx;
  color: #333;
}

.rule-points {
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.rule-points.bonus {
  color: #f44336;
}

/* ========== 积分明细 ========== */
.log-group {
  margin-bottom: 16rpx;
}

.log-date-label {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
  display: block;
  padding: 10rpx 0 4rpx;
}

.log-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.log-group .log-item:last-child {
  border-bottom: none;
}

.log-left {
  display: flex;
  flex-direction: column;
}

.log-desc {
  font-size: 28rpx;
  color: #333;
}

.log-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
}

.log-points {
  font-size: 30rpx;
  font-weight: 600;
}

.log-points.positive {
  color: var(--primary-color);
}

.log-points.negative {
  color: #f44336;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #bbb;
  margin-top: 8rpx;
}

/* ========== 加载更多 ========== */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0;
}

.no-more {
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}

.no-more-text {
  font-size: 22rpx;
  color: #ccc;
}

/* ========== 底部入口 ========== */
.action-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  transition: transform 0.2s ease, background 0.2s ease;
}

.action-card:active {
  background: #f9f9f9;
  transform: scale(0.98);
}

.action-left {
  align-items: center;
}

.action-icon-text {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.action-text {
  font-size: 30rpx;
  color: #333;
}

.action-arrow {
  font-size: 36rpx;
  color: #ccc;
}
