/* pages/copybook/articles/index.wxss - 素材文章列表样式 */

/* ========== Tab栏 ========== */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 16rpx;
  position: relative;
  transition: color 0.3s ease;
}

.tab-item .tab-text {
  font-size: 30rpx;
  color: #999;
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: var(--primary-color, #07c160);
  font-weight: 600;
}

.tab-indicator {
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--primary-color, #07c160);
  margin-top: 8rpx;
}

/* ========== 阶段分组 ========== */
.stage-group {
  margin-bottom: 24rpx;
}

.stage-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
}

.stage-number {
  font-size: 24rpx;
  color: var(--primary-color, #07c160);
  font-weight: 600;
  background: rgba(7, 193, 96, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.stage-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

/* ========== 课程卡片 ========== */
.lesson-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  background: #fff;
  margin: 0 24rpx 12rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.lesson-card:active {
  transform: scale(0.98);
}

.lesson-card.current {
  border: 2rpx solid var(--primary-color, #07c160);
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.15);
}

.lesson-card.completed {
  opacity: 0.85;
}

.lesson-card.locked {
  opacity: 0.5;
  background: #f9f9f9;
}

.lesson-card.locked:active {
  transform: none;
}

.lesson-status {
  flex-shrink: 0;
  width: 48rpx;
  text-align: center;
}

.status-icon {
  font-size: 32rpx;
}

.lesson-info {
  flex: 1;
  min-width: 0;
}

.lesson-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.lesson-tips {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ========== 解锁面板 ========== */
.unlock-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 48rpx;
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 20rpx;
}

.unlock-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.unlock-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.unlock-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.unlock-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.unlock-label {
  font-size: 26rpx;
  color: #666;
  width: 140rpx;
  flex-shrink: 0;
}

.progress-bar {
  flex: 1;
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-color, #07c160), var(--primary-light, #4cd964));
  border-radius: 8rpx;
  transition: width 0.5s ease;
  min-width: 0;
}

.unlock-value {
  font-size: 26rpx;
  color: var(--primary-color, #07c160);
  font-weight: 600;
  width: 100rpx;
  text-align: right;
  flex-shrink: 0;
}

/* ========== 每日素材卡片 ========== */
.daily-article {
  background: #fff;
  margin: 20rpx 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
}

.daily-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.daily-tag {
  font-size: 22rpx;
  color: #fff;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
}

.daily-date {
  font-size: 24rpx;
  color: #999;
}

.daily-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.daily-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  display: block;
  margin-bottom: 24rpx;
}

.daily-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.daily-chars {
  font-size: 24rpx;
  color: #999;
}

.generate-btn {
  background: linear-gradient(135deg, var(--primary-color, #07c160), var(--primary-light, #4cd964));
  border-radius: 24rpx;
  padding: 10rpx 32rpx;
  transition: opacity 0.2s ease, transform 0.15s ease;
}

.generate-btn:active {
  opacity: 0.85;
  transform: scale(0.95);
}

.generate-btn-text {
  font-size: 26rpx;
  color: #fff;
}

/* ========== 通用状态 ========== */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #bbb;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
}
