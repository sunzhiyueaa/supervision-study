/* pages/copybook/articles/index.wxss - 素材文章列表样式 */

/* ========== 搜索栏 ========== */
.search-bar {
  margin-bottom: 20rpx;
}

.search-wrapper {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--border-color, #e0e0e0);
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.search-wrapper:focus-within {
  border-color: var(--primary-color, #07c160);
  box-shadow: 0 0 0 4rpx rgba(7, 193, 96, 0.1);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
}

.search-clear {
  font-size: 28rpx;
  color: #999;
  padding: 10rpx;
}

/* ========== 分类标签 ========== */
.category-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.category-item {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666;
  background: #f0f0f0;
  transition: all 0.3s ease;
}

.category-item.active {
  color: #ffffff;
  background: linear-gradient(135deg, var(--primary-color, #07c160), var(--primary-light, #4cd964));
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

/* ========== 文章卡片 ========== */
.article-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.article-card:active {
  transform: scale(0.98);
}

.article-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.source-tag {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  color: #fff;
}

.source-red {
  background: linear-gradient(135deg, #e53935, #EF5350);
}

.source-blue {
  background: linear-gradient(135deg, #1E88E5, #42A5F5);
}

.source-orange {
  background: linear-gradient(135deg, #FB8C00, #FFA726);
}

.source-gray {
  background: linear-gradient(135deg, #9e9e9e, #BDBDBD);
}

.article-tag {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  color: var(--primary-color, #07c160);
  background: rgba(7, 193, 96, 0.1);
}

.article-chars {
  font-size: 22rpx;
  color: #999;
  margin-left: auto;
}

.article-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 16rpx;
}

.article-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.article-date {
  font-size: 22rpx;
  color: #999;
}

.generate-btn {
  background: linear-gradient(135deg, var(--primary-color, #07c160), var(--primary-light, #4cd964));
  border-radius: 24rpx;
  padding: 8rpx 28rpx;
  transition: opacity 0.2s ease, transform 0.15s ease;
}

.generate-btn:active {
  opacity: 0.85;
  transform: scale(0.95);
}

.generate-btn-text {
  font-size: 24rpx;
  color: #fff;
}

/* ========== 加载中 ========== */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* ========== 没有更多 ========== */
.no-more {
  display: flex;
  justify-content: center;
  padding: 30rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #ccc;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #bbb;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
}

/* ========== 底部添加按钮 ========== */
.add-btn-wrapper {
  padding: 20rpx 0 60rpx;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 2rpx dashed var(--primary-color, #07c160);
  border-radius: 16rpx;
  padding: 24rpx;
  gap: 12rpx;
  transition: background 0.2s ease;
}

.add-btn:active {
  background: rgba(7, 193, 96, 0.05);
}

.add-btn-icon {
  font-size: 36rpx;
  color: var(--primary-color, #07c160);
  font-weight: bold;
}

.add-btn-text {
  font-size: 28rpx;
  color: var(--primary-color, #07c160);
}

/* ========== 弹窗遮罩 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease both;
}

.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  animation: scaleIn 0.3s ease both;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 32rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
}

.form-input {
  height: 72rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  transition: border-color 0.3s ease;
}

.form-input:focus {
  border-color: var(--primary-color, #07c160);
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  transition: border-color 0.3s ease;
}

.form-textarea:focus {
  border-color: var(--primary-color, #07c160);
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx 30rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
}
