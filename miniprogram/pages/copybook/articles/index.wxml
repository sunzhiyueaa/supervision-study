<!-- pages/copybook/articles/index.wxml - 素材文章列表（课程 + 每日素材） -->
<view class="container">
  <!-- 顶部Tab -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-tab="0">
      <text class="tab-text">课程</text>
      <view class="tab-indicator" wx:if="{{activeTab === 0}}"></view>
    </view>
    <view class="tab-item {{activeTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-tab="1">
      <text class="tab-text">每日素材</text>
      <view class="tab-indicator" wx:if="{{activeTab === 1}}"></view>
    </view>
  </view>

  <!-- 课程Tab -->
  <view class="tab-content" wx:if="{{activeTab === 0}}">
    <!-- 加载中 -->
    <view class="loading-state" wx:if="{{loading}}">
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 课程列表（按阶段分组） -->
    <view class="stage-group" wx:for="{{lessonsByStage}}" wx:key="stage">
      <view class="stage-header">
        <text class="stage-number">阶段{{item.stage}}</text>
        <text class="stage-name">{{item.stageName}}</text>
      </view>
      <view class="lesson-list">
        <view class="lesson-card {{lesson.isUnlocked ? '' : 'locked'}} {{lesson.isCurrent ? 'current' : ''}} {{lesson.isCompleted ? 'completed' : ''}}"
              wx:for="{{item.lessons}}" wx:for-item="lesson" wx:key="lessonNo"
              bindtap="onTapLesson" data-lesson="{{lesson}}">
          <view class="lesson-status">
            <text class="status-icon">{{lesson.statusText}}</text>
          </view>
          <view class="lesson-info">
            <text class="lesson-title">第{{lesson.lessonNo}}课：{{lesson.title}}</text>
            <text class="lesson-tips" wx:if="{{lesson.isUnlocked}}">{{lesson.tips}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && lessonsByStage.length === 0}}">
      <text class="empty-icon">📚</text>
      <text class="empty-text">暂无课程数据</text>
    </view>
  </view>

  <!-- 每日素材Tab -->
  <view class="tab-content" wx:if="{{activeTab === 1}}">
    <!-- 未解锁状态 -->
    <view class="unlock-panel" wx:if="{{mode !== 'dev' && (!courseProgress || !courseProgress.dailyUnlocked)}}">
      <view class="unlock-icon">🔒</view>
      <text class="unlock-title">每日素材未解锁</text>
      <text class="unlock-desc">完成以下条件即可解锁：</text>

      <!-- 课程进度 -->
      <view class="unlock-item">
        <text class="unlock-label">课程完成</text>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{courseProgress.completedLessons.length / 37 * 100}}%"></view>
        </view>
        <text class="unlock-value">{{courseProgress.completedLessons.length || 0}}/37</text>
      </view>

      <!-- 积分进度 -->
      <view class="unlock-item">
        <text class="unlock-label">当前积分</text>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{courseProgress.totalPoints / 500 * 100 > 100 ? 100 : courseProgress.totalPoints / 500 * 100}}%"></view>
        </view>
        <text class="unlock-value">{{courseProgress.totalPoints || 0}}/500</text>
      </view>
    </view>

    <!-- 已解锁：加载中 -->
    <view class="loading-state" wx:if="{{dailyLoading}}">
      <text class="loading-text">素材生成中，请稍候...</text>
    </view>

    <!-- 已解锁：今日素材 -->
    <view class="daily-article" wx:if="{{dailyArticle}}">
      <view class="daily-header">
        <text class="daily-tag">今日素材</text>
        <text class="daily-date">{{dailyArticle.publishDate}}</text>
      </view>
      <text class="daily-title" wx:if="{{dailyArticle.title}}">{{dailyArticle.title}}</text>
      <text class="daily-content">{{dailyArticle.content}}</text>
      <view class="daily-footer">
        <text class="daily-chars">{{dailyArticle.charCount}}字</text>
        <view class="generate-btn" bindtap="onTapDailyArticle">
          <text class="generate-btn-text">生成字帖</text>
        </view>
      </view>
    </view>

    <!-- 已解锁：暂无素材 -->
    <view class="empty-state" wx:if="{{!dailyLoading && !dailyArticle && (mode === 'dev' || (courseProgress && courseProgress.dailyUnlocked))}}">
      <text class="empty-icon">📝</text>
      <text class="empty-text">今日素材暂未生成</text>
      <text class="empty-hint">每日凌晨2点自动生成，或稍后刷新</text>
    </view>
  </view>
</view>
