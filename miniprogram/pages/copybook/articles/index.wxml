<!-- pages/copybook/articles/index.wxml - 素材文章列表 -->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-wrapper">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索素材内容" 
             bindinput="onSearchInput" bindconfirm="onSearchConfirm" 
             value="{{keyword}}" confirm-type="search" />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="onSearchClear">✕</text>
    </view>
  </view>

  <!-- 分类标签 -->
  <scroll-view class="category-scroll" scroll-x enable-flex>
    <view class="category-item {{currentCategory === '' ? 'active' : ''}}" 
          bindtap="setCategory" data-cat="">
      <text>全部</text>
    </view>
    <view class="category-item {{currentCategory === item ? 'active' : ''}}"
          wx:for="{{categories}}" wx:key="*this"
          bindtap="setCategory" data-cat="{{item}}">
      <text>{{item}}</text>
    </view>
  </scroll-view>

  <!-- 文章列表 -->
  <view class="article-list">
    <view class="article-card card anim-stagger" wx:for="{{articles}}" wx:key="_id"
          style="animation-delay: {{index * 0.06}}s;">
      <view class="article-header">
        <text class="source-tag source-{{item.sourceType}}">{{item.sourceName}}</text>
        <text class="article-tag">{{item.tagText}}</text>
        <text class="article-chars">{{item.charCountText}}</text>
      </view>
      <text class="article-content">{{item.content}}</text>
      <view class="article-footer">
        <text class="article-date">{{item.publishDate}}</text>
        <view class="generate-btn" bindtap="goToGenerate" data-article="{{item}}">
          <text class="generate-btn-text">生成字帖</text>
        </view>
      </view>
    </view>

    <!-- 加载中 -->
    <view class="loading-state" wx:if="{{loading}}">
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && articles.length > 0}}">
      <text class="no-more-text">— 没有更多了 —</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && articles.length === 0}}">
      <text class="empty-icon">📝</text>
      <text class="empty-text">暂无素材</text>
      <text class="empty-hint">点击下方按钮添加自定义素材</text>
    </view>
  </view>

  <!-- 底部添加按钮 -->
  <view class="add-btn-wrapper">
    <view class="add-btn" bindtap="openAddModal">
      <text class="add-btn-icon">+</text>
      <text class="add-btn-text">添加自定义素材</text>
    </view>
  </view>
</view>

<!-- 添加素材弹窗 -->
<view class="modal-mask" wx:if="{{showAddModal}}" bindtap="closeAddModal">
  <view class="modal-content" catchtap="preventBubble">
    <view class="modal-header">
      <text class="modal-title">添加自定义素材</text>
      <text class="modal-close" bindtap="closeAddModal">✕</text>
    </view>
    <view class="modal-body">
      <view class="form-item">
        <text class="form-label">来源</text>
        <input class="form-input" placeholder="如：人民日报、半月谈" 
               bindinput="onAddFormInput" data-field="source" value="{{addForm.source}}" />
      </view>
      <view class="form-item">
        <text class="form-label">标题</text>
        <input class="form-input" placeholder="给素材起个名字" 
               bindinput="onAddFormInput" data-field="title" value="{{addForm.title}}" />
      </view>
      <view class="form-item">
        <text class="form-label">内容</text>
        <textarea class="form-textarea" placeholder="输入要练字的内容" 
                  bindinput="onAddFormInput" data-field="content" value="{{addForm.content}}" 
                  maxlength="200" auto-height />
      </view>
      <view class="form-item">
        <text class="form-label">分类</text>
        <input class="form-input" placeholder="如：时政金句、人生哲理" 
               bindinput="onAddFormInput" data-field="tags" value="{{addForm.tags}}" />
      </view>
    </view>
    <view class="modal-footer">
      <view class="btn-secondary modal-btn" bindtap="closeAddModal">取消</view>
      <view class="btn-primary modal-btn" bindtap="submitAddArticle">添加</view>
    </view>
  </view>
</view>
