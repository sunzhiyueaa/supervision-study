/* pages/copybook/gallery/index.wxss - 已生成字帖样式 */

/* ========== 字帖网格 ========== */
.gallery-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.gallery-item {
  width: calc(50% - 10rpx);
  padding: 0;
  overflow: hidden;
  box-sizing: border-box;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.gallery-item:active {
  transform: scale(0.96);
}

/* 缩略预览区域 */
.gallery-preview {
  width: 100%;
  height: 240rpx;
  background: linear-gradient(180deg, #fafafa, #f5f5f5);
  display: flex;
  justify-content: center;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.preview-text {
  font-size: 36rpx;
  color: #333;
  font-family: KaiTi, 楷体, STKaiti, serif;
  text-align: center;
  padding: 16rpx;
  word-break: break-all;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 信息区域 */
.gallery-info {
  padding: 16rpx;
}

.gallery-title {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gallery-tags {
  display: flex;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.gallery-tag {
  font-size: 18rpx;
  color: var(--primary-color, #07c160);
  background: rgba(7, 193, 96, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.gallery-date {
  font-size: 22rpx;
  color: #999;
  display: block;
}

/* ========== 加载中 ========== */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  animation: fadeIn 0.5s ease both;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #bbb;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
  margin-bottom: 30rpx;
}

.empty-btn {
  background: linear-gradient(135deg, var(--primary-color, #07c160), var(--primary-light, #4cd964));
  border-radius: 32rpx;
  padding: 16rpx 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
  transition: opacity 0.2s ease, transform 0.15s ease;
}

.empty-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.empty-btn-text {
  font-size: 28rpx;
  color: #fff;
}
