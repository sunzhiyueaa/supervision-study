<!-- pages/copybook/generate/index.wxml - 字帖生成 -->
<view class="container">
  <!-- 文本内容编辑 -->
  <view class="card">
    <view class="section-header">
      <text class="section-title">练字内容</text>
      <text class="source-label" wx:if="{{sourceName}}">{{sourceName}}</text>
    </view>
    <textarea class="text-editor" value="{{text}}" bindinput="onTextInput" 
              placeholder="请输入要练字的内容" maxlength="200" auto-height />
    <view class="text-counter">
      <text class="counter-text">{{text.length}}/200</text>
    </view>
  </view>

  <!-- 配置选项 -->
  <view class="card mt-20">
    <text class="section-title">字帖设置</text>

    <!-- 字体样式 -->
    <view class="option-row">
      <text class="option-label">字体样式</text>
      <view class="radio-group">
        <view class="radio-item {{fontStyle === item ? 'active' : ''}}" 
              wx:for="{{fontStyles}}" wx:key="*this"
              bindtap="onFontStyleChange" data-value="{{index}}">
          <text class="radio-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 格子类型 -->
    <view class="option-row">
      <text class="option-label">格子类型</text>
      <view class="grid-type-group">
        <view class="grid-type-item {{gridType === item ? 'active' : ''}}" 
              wx:for="{{gridTypes}}" wx:key="*this"
              bindtap="onGridTypeSelect" data-type="{{item}}">
          <view class="grid-icon grid-icon-{{index}}">
            <view class="grid-icon-inner"></view>
          </view>
          <text class="grid-type-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 练习模式（仅课程模式显示） -->
    <view class="option-row" wx:if="{{sourceType === 'course'}}">
      <text class="option-label">练习模式</text>
      <view class="radio-group">
        <view class="radio-item {{(practiceMode === 'trace' && index === 0) || (practiceMode === 'one-empty' && index === 1) || (practiceMode === 'one-extra' && index === 2) ? 'active' : ''}}"
              wx:for="{{practiceModeLabels}}" wx:key="*this"
              bindtap="onPracticeModeSelect" data-index="{{index}}">
          <text class="radio-text">{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 生成预览按钮 -->
  <view class="mt-20">
    <button class="btn-primary action-btn" bindtap="previewCopybook" disabled="{{!text}}">
      生成预览
    </button>
  </view>

  <!-- 预览区域 -->
  <view class="card mt-20">
    <text class="section-title">字帖预览</text>
    <view class="preview-wrapper" bindtap="previewImage">
      <canvas type="2d" id="copybookCanvas" class="copybook-canvas"
              style="width: 100%; height: 600rpx;"></canvas>
      <view class="preview-empty" wx:if="{{!layoutData}}">
        <text class="preview-empty-text">配置好后点击"生成预览"</text>
      </view>
      <view class="preview-hint" wx:if="{{layoutData}}">
        <text class="preview-hint-text">点击查看大图</text>
      </view>
    </view>
  </view>

  <!-- A4打印画布（隐藏，仅用于导出高清图片） -->
  <canvas type="2d" id="a4Canvas" class="a4-canvas"></canvas>

  <!-- 操作按钮 -->
  <view class="btn-group mt-20">
    <button class="btn-primary action-btn" bindtap="generateAndSave" 
            loading="{{saving}}" disabled="{{!text}}">
      生成并保存到相册
    </button>
    <button class="btn-secondary action-btn mt-20" bindtap="addToFavorite" 
            loading="{{generating}}" disabled="{{!text}}">
      添加到收藏
    </button>
  </view>
</view>
