/* pages/settings/index.wxss - 设置页样式 */

/* 设置行 */
.setting-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-left {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-right: 20rpx;
}

.setting-label {
  font-size: 28rpx;
  color: #333;
}

.setting-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.setting-value {
  font-size: 28rpx;
  color: #999;
}

/* 时间选择器 */
.time-picker {
  display: flex;
  align-items: center;
  background: #f5f7f5;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
}

.time-value {
  font-size: 30rpx;
  color: var(--primary-color, #07c160);
  font-weight: 600;
}

.time-arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 8rpx;
}

/* 订阅按钮 */
.subscribe-btn {
  background: rgba(7, 193, 96, 0.1);
  padding: 10rpx 28rpx;
  border-radius: 24rpx;
}

.subscribe-text {
  font-size: 26rpx;
  color: var(--primary-color, #07c160);
  font-weight: 500;
}

/* 提醒规则 */
.reminder-rules {
  margin-top: 16rpx;
  background: #f9faf9;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.rules-title {
  font-size: 24rpx;
  color: #666;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.rules-item {
  font-size: 22rpx;
  color: #999;
  display: block;
  line-height: 1.8;
}

/* 数据统计 */
.stats-grid {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stats-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary-color, #07c160);
  line-height: 1.2;
  animation: countUp 0.6s ease both;
}

.stats-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 保存按钮 */
.save-wrap {
  padding: 0 30rpx;
}

.save-btn {
  width: 100%;
  margin: 0;
}

/* ========== 字体管理 ========== */
.font-upload-btn {
  padding: 24rpx;
  background: #f5f5f5;
  border: 2rpx dashed #d0d0d0;
  border-radius: 12rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.font-upload-text {
  font-size: 28rpx;
  color: #666;
}

.font-tip {
  padding: 20rpx 0;
}

.font-tip-text {
  font-size: 24rpx;
  color: #999;
}

.font-list-title {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.font-list-title-text {
  font-size: 26rpx;
  color: #666;
}

.font-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.font-item:last-child {
  border-bottom: none;
}

.font-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.font-name {
  font-size: 28rpx;
  color: #333;
}

.font-size {
  font-size: 22rpx;
  color: #999;
}

.font-delete {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  background: #fff0f0;
}

.font-delete-text {
  font-size: 24rpx;
  color: #e74c3c;
}
