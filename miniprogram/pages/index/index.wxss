/* pages/index/index.wxss - 首页样式 */

/* ========== 订阅消息引导条 ========== */
.subscribe-banner {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FFF8E1, #FFE082);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.subscribe-banner-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.subscribe-banner-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.subscribe-banner-text {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.subscribe-banner-title {
  font-size: 28rpx;
  color: #E65100;
  font-weight: 600;
}

.subscribe-banner-desc {
  font-size: 22rpx;
  color: #BF360C;
  opacity: 0.7;
  margin-top: 2rpx;
}

.subscribe-banner-action {
  font-size: 26rpx;
  color: #ffffff;
  background: #FF9800;
  padding: 8rpx 28rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.subscribe-banner-close {
  font-size: 28rpx;
  color: #BF360C;
  opacity: 0.5;
  padding: 10rpx;
  margin-left: 8rpx;
}

/* ========== 顶部卡片（渐变背景） ========== */
.header-card {
  background: linear-gradient(135deg, #07c160, #4cd964);
  color: #ffffff;
  position: relative;
  overflow: hidden;
}

/* 装饰圆形背景 */
.header-bg-decor {
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.header-card .header-bg-decor::before {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: -100rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.header-top {
  align-items: center;
  position: relative;
  z-index: 1;
}

.date-wrap {
  display: flex;
  flex-direction: column;
}

.greeting-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 8rpx;
}

.date-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
}

.weekday-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

.streak-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 12rpx 24rpx;
  backdrop-filter: blur(4rpx);
}

.streak-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
}

.streak-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 鼓励文字 */
.encourage-bar {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  position: relative;
  z-index: 1;
}

.encourage-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  text-align: center;
  display: block;
}

/* ========== 任务卡片 ========== */
.task-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.task-card:active {
  background-color: #f9f9f9;
  transform: scale(0.98);
}

.task-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.task-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  transition: transform 0.2s ease;
}

.task-icon-text {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 600;
}

.bg-green {
  background: linear-gradient(135deg, #07c160, #4cd964);
}

.bg-orange {
  background: linear-gradient(135deg, #FF9800, #FFA726);
}

.bg-blue {
  background: linear-gradient(135deg, #2196F3, #42A5F5);
}

.bg-purple {
  background: linear-gradient(135deg, #9C27B0, #BA68C8);
}

.bg-red {
  background: linear-gradient(135deg, #f44336, #EF5350);
}

.bg-gray {
  background: linear-gradient(135deg, #607D8B, #90A4AE);
}

.task-info {
  display: flex;
  flex-direction: column;
}

.task-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.task-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.task-status {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  transition: all 0.3s ease;
}

.task-status.pending {
  color: var(--primary-color);
  background: rgba(7, 193, 96, 0.1);
}

.task-status.done {
  color: #999;
  background: #f5f5f5;
}

.task-checkmark {
  font-size: 24rpx;
  color: var(--primary-color);
  animation: checkmark 0.4s ease both;
}

/* ========== 本周完成情况 ========== */
.week-bar {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 16rpx;
}

.week-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.week-label {
  font-size: 22rpx;
  color: #999;
  transition: color 0.3s ease;
}

.week-label-active {
  color: var(--primary-color);
  font-weight: 600;
}

.week-dot-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.week-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #e0e0e0;
  transition: all 0.3s ease;
}

.week-dot.active {
  background: var(--primary-color);
  animation: scaleIn 0.3s ease both;
}

.week-dot-ring {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(7, 193, 96, 0.3);
  animation: pulse 2s ease infinite;
}

.week-date {
  font-size: 20rpx;
  color: #ccc;
}

/* ========== 快捷入口 ========== */
.shortcut-grid {
  display: flex;
  flex-wrap: wrap;
}

.shortcut-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
  transition: transform 0.2s ease;
}

.shortcut-item:active {
  transform: scale(0.92);
}

.shortcut-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.shortcut-icon-text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 500;
}

.shortcut-label {
  font-size: 24rpx;
  color: #666;
}
