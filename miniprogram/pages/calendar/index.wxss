/* pages/calendar/index.wxss - 日历记录页样式 */

/* ========== 日历卡片 ========== */
.calendar-card {
  padding: 10rpx;
}

/* ========== 月度统计卡片 ========== */
.stats-card {
  padding: 30rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8fdf8 100%);
}

/* 完成率进度条 */
.stats-progress-section {
  margin-bottom: 30rpx;
}

.stats-progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.stats-progress-label {
  font-size: 28rpx;
  color: var(--text-secondary, #666);
}

.stats-progress-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary-color, #07c160);
  animation: countUp 0.6s ease both;
}

.stats-progress-bar {
  width: 100%;
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.stats-progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(to right, var(--primary-light, #4cd964), var(--primary-color, #07c160));
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.stats-progress-detail {
  font-size: 24rpx;
  color: var(--text-hint, #999);
}

/* 统计数字行 */
.stats-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 16rpx 0 0;
  border-top: 1rpx solid #f0f0f0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #f0f0f0;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary-color, #07c160);
  line-height: 1.2;
  animation: countUp 0.6s ease both;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-hint, #999);
  margin-top: 6rpx;
}

/* ========== 日期详情 ========== */
.day-detail {
  margin-top: 10rpx;
}

.detail-card {
  padding: 20rpx;
  animation: slideUp 0.3s ease both;
}

/* 详情图片 */
.detail-photo-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.detail-photo {
  width: 100%;
  max-height: 400rpx;
  border-radius: 12rpx;
  background: #f8f9f8;
}

/* 详情额外信息 */
.detail-info {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.detail-info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.detail-info-label {
  font-size: 26rpx;
  color: var(--text-hint, #999);
}

.detail-info-value {
  font-size: 26rpx;
  color: var(--text-secondary, #666);
  font-weight: 500;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 60rpx 0;
  animation: fadeIn 0.5s ease both;
}

.empty-text {
  font-size: 28rpx;
  color: #bbb;
  margin-top: 8rpx;
}
