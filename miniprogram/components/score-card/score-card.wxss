/* components/score-card/score-card.wxss */
.score-card-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
}

/* ========== 圆环进度条 ========== */
.score-ring-container {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 20rpx;
}

.score-ring-svg {
  position: absolute;
  top: 0;
  left: 0;
  width: 220rpx;
  height: 220rpx;
}

.score-ring-text {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: center;
}

.score-number {
  font-size: 68rpx;
  font-weight: 700;
  color: var(--primary-color, #07c160);
  line-height: 1;
  animation: countUp 0.6s ease both;
}

.score-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 4rpx;
  margin-bottom: 12rpx;
}

/* ========== 评语 ========== */
.score-comment {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
  text-align: center;
}

/* ========== 各项分数 ========== */
.breakdown-section {
  width: 100%;
  padding: 0 20rpx;
}

.breakdown-item {
  margin-bottom: 20rpx;
}

.breakdown-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.breakdown-label {
  font-size: 24rpx;
  color: #666;
}

.breakdown-value {
  font-size: 24rpx;
  color: #999;
}

.breakdown-bar {
  width: 100%;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.breakdown-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.confidence-fill {
  background: linear-gradient(to right, #4cd964, #07c160);
}

.quantity-fill {
  background: linear-gradient(to right, #42A5F5, #1E88E5);
}

.neatness-fill {
  background: linear-gradient(to right, #FFA726, #FF9800);
}

/* ========== OCR识别文字区域 ========== */
.ocr-section {
  width: 100%;
  margin-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.ocr-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.ocr-toggle-text {
  font-size: 26rpx;
  color: #666;
}

.ocr-toggle-arrow {
  font-size: 24rpx;
  color: var(--primary-color, #07c160);
}

.ocr-content {
  margin-top: 12rpx;
  padding: 20rpx;
  background: #f8f9f8;
  border-radius: 12rpx;
  animation: slideDown 0.3s ease both;
}

.ocr-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  word-break: break-all;
}
